Index: src/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
===================================================================
--- src.orig/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
+++ src/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
@@ -22,6 +22,7 @@
 #include "chrome/browser/themes/theme_service.h"
 #include "chrome/browser/themes/theme_service_factory.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium/helium_layout_state_controller.h"
 #include "chrome/browser/ui/cocoa/fullscreen/fullscreen_menubar_tracker.h"
 #include "chrome/browser/ui/cocoa/fullscreen/fullscreen_toolbar_controller.h"
 #include "chrome/browser/ui/color/chrome_color_id.h"
@@ -527,6 +528,73 @@ void BrowserFrameViewMac::Layout(PassKey
     LayoutWindowControlsOverlay();
   }
   LayoutSuperclass<BrowserFrameView>(this);
+
+  // Dia-style: inset the native traffic lights from the window edges in
+  // vertical layout. AppKit owns their geometry and re-asserts it on its own
+  // layout triggers, so re-assert absolute positions every pass. Positions
+  // are only assigned when they actually differ, so this can't layout-loop.
+  // Fullscreen keeps native placement.
+  if (!GetBrowserView()->IsFullscreen()) {
+    if (auto* layout_controller = HeliumLayoutStateController::From(
+            GetBrowserView()->browser());
+        layout_controller && layout_controller->IsVerticalLayout()) {
+      NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+      if (window) {
+        // Dia spacing from the window edges, in points.
+        constexpr CGFloat kDiaTrafficLightLeading = 30;
+        constexpr CGFloat kDiaTrafficLightTop = 26;
+        NSView* close_button =
+            [window standardWindowButton:NSWindowCloseButton];
+        NSView* superview = close_button.superview;
+        if (superview) {
+          const CGFloat superview_width = superview.bounds.size.width;
+          const CGFloat superview_height = superview.bounds.size.height;
+          const BOOL rtl = base::i18n::IsRTL();
+          // Preserve AppKit's inter-button spacing: measure the group, then
+          // shift it so its leading edge sits at the Dia margin.
+          CGFloat group_min_x = CGFLOAT_MAX;
+          CGFloat group_max_x = 0;
+          NSView* buttons[3];
+          int count = 0;
+          for (NSWindowButton button : {NSWindowCloseButton,
+                                        NSWindowMiniaturizeButton,
+                                        NSWindowZoomButton}) {
+            NSView* button_view = [window standardWindowButton:button];
+            if (!button_view || button_view.superview != superview) {
+              continue;
+            }
+            buttons[count++] = button_view;
+            group_min_x = std::min(group_min_x, NSMinX(button_view.frame));
+            group_max_x = std::max(group_max_x, NSMaxX(button_view.frame));
+          }
+          if (count > 0) {
+            const CGFloat group_width = group_max_x - group_min_x;
+            const CGFloat target_min_x =
+                rtl ? superview_width - kDiaTrafficLightLeading - group_width
+                    : kDiaTrafficLightLeading;
+            const CGFloat dx = target_min_x - group_min_x;
+            for (int i = 0; i < count; ++i) {
+              NSRect frame = buttons[i].frame;
+              frame.origin.x += dx;
+              // The theme frame is flipped (top-down); fall back to
+              // bottom-up math if that ever changes.
+              const CGFloat target_y =
+                  superview.isFlipped
+                      ? kDiaTrafficLightTop
+                      : superview_height - kDiaTrafficLightTop -
+                            NSHeight(frame);
+              frame.origin.y = target_y;
+              const NSRect current = buttons[i].frame;
+              if (fabs(NSMinX(frame) - NSMinX(current)) > 0.5 ||
+                  fabs(NSMinY(frame) - NSMinY(current)) > 0.5) {
+                buttons[i].frame = frame;
+              }
+            }
+          }
+        }
+      }
+    }
+  }
 }
 
